# Copie para deploy/.env (que fica fora do git) e preencha.

# Token do túnel, copiado do painel da Cloudflare (Zero Trust > Networks > Tunnels).
# É um segredo: quem tiver o token consegue publicar no lugar do site.
CLOUDFLARE_TUNNEL_TOKEN=

# Endereço público e link "Entrar" (lidos no build; mudar exige --build).
LOCKON_SITE_URL=https://lockons.com.br
LOCKON_APP_URL=
